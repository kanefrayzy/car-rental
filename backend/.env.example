APP_NAME="Bueno Exotics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bookings@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Rental -------------------------------------------------------------
# The website that calls this API (comma-separated if there are several).
FRONTEND_URL=http://localhost:3000
# Where new booking requests are sent. Empty: the owner gets no email.
RENTAL_OWNER_EMAIL=
RENTAL_TIMEZONE=America/New_York
RENTAL_DEPOSIT_USD=1000
RENTAL_MIN_DAYS=1
RENTAL_MAX_DAYS=30
# Hours an unpaid request keeps its dates before they open up again.
RENTAL_HOLD_HOURS=24
# Days to keep licences and insurance cards after the rental (stated on the privacy page).
RENTAL_DOCUMENT_RETENTION_DAYS=180
# The "Leave a review" link in the thank-you email after a rental (Google Business Profile,
# "Ask for reviews"). Empty: no review request is sent.
GOOGLE_REVIEW_URL=
# Hours from "Mark as returned" in the admin panel to that email. Needs a queue worker
# (php artisan queue:work); without one the email waits in the jobs table.
RENTAL_REVIEW_DELAY_HOURS=3
# Behind an HTTPS proxy in production: its address, or * if the API is reachable only through it.
TRUSTED_PROXIES=

# --- Stripe (deposits) ---------------------------------------------------
# Leave STRIPE_SECRET empty to keep payments switched off.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# automatic = charge the deposit, manual = only place a hold on the card.
STRIPE_CAPTURE_METHOD=automatic
