    "check:back": "node scripts/check-back-button.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5"
