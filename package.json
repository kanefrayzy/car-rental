{
  "name": "car-rental",
  "private": true,
  "type": "module",
  "description": "Monorepo tooling for the car rental site (image pipeline, screenshots). The app lives in /frontend.",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
