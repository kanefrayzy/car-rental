# Copy to .env.local (not committed) and adjust.

# Address of the Laravel API in /backend, ending in /api.
# Leave it empty to run the site on its built-in mock, with no backend at all.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Microsoft Clarity project ID (session recordings, lib/clarity.ts). Loaded only in a
# production build, never under /be, for ?ga_debug=1 sessions or after Decline.
# Production reads CLARITY_PROJECT_ID from deploy/.env on the server.
NEXT_PUBLIC_CLARITY_ID=z5fvp5otj3
