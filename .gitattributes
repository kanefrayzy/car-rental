# The server checks this repository out on Linux: text files always have LF endings there,
# whatever this machine's core.autocrlf says. Shell scripts break with CRLF.
* text=auto eol=lf
*.sh text eol=lf

# Binary files: never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.gif binary
*.mp3 binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
