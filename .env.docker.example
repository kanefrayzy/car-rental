# Optional settings for `docker compose`. Copy to ".env" next to docker-compose.yml
# (it is not committed). Everything here has a working default.

# Ports on your machine. Change them if something else already uses 3000 or 8000.
# After changing WEB_PORT or API_PORT, rebuild: docker compose up --build
WEB_PORT=3000
API_PORT=8000
MAIL_UI_PORT=8025

# Where new booking requests are emailed. In Docker all mail lands in the catcher
# at http://localhost:8025, whatever address is written here.
RENTAL_OWNER_EMAIL=owner@example.com
RENTAL_DEPOSIT_USD=1000
# Days to keep licences and insurance cards after the rental (stated on the privacy page).
RENTAL_DOCUMENT_RETENTION_DAYS=180
# The "Leave a review" link in the thank-you email after a return, and the hours until
# it goes out (set 0 to try the email right away). Empty link: no email.
GOOGLE_REVIEW_URL=
RENTAL_REVIEW_DELAY_HOURS=3

# The owner's account for the admin panel at http://localhost:8000/admin. Created on the
# first start when both are set (10+ characters). Later password changes are made in the
# panel (top right, Profile) and are kept across restarts.
# Without a password here, make the account by hand:
#   docker compose exec backend php artisan admin:user you@example.com
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# Stripe test keys. Empty: deposits stay switched off.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Database passwords for the local containers.
DB_PASSWORD=rental-local
DB_ROOT_PASSWORD=root-local

# The blog: the shared secret for the API's "refresh the blog pages" call to the website.
# The default is fine on a developer's machine.
BLOG_REVALIDATE_SECRET=local-blog-secret
