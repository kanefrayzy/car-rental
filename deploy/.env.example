# Settings for deploy/docker-compose.yml. Copy to deploy/.env on the server (never commit it).

DOMAIN=buenoexoticsny.com

# Long random strings: openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# The owner's admin panel login (https://DOMAIN/admin). Created on the first start; the
# password is then changed in the panel (Profile) and restarts keep the new one.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email. "log" writes emails to the container log instead of sending them: nobody gets
# them. For real email, use a mail service (Resend, Postmark, Brevo, Amazon SES...):
#   MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT=587, MAIL_USERNAME, MAIL_PASSWORD,
# and send from an address on DOMAIN after adding the service's DNS records (SPF, DKIM).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
# Where new booking requests are emailed. Empty: no owner email (the admin panel still
# shows every request). Also the Reply-To of customer emails.
RENTAL_OWNER_EMAIL=info@buenoexoticsny.com
# Where the contact form on the website sends questions.
RENTAL_CONTACT_EMAIL=info@buenoexoticsny.com

RENTAL_DEPOSIT_USD=1000
RENTAL_DOCUMENT_RETENTION_DAYS=180

# Stripe: the publishable key (pk_...) goes into the website, the secret and the webhook
# signing secret (whsec_..., from the webhook endpoint for https://DOMAIN/api/stripe/webhook)
# stay on the API. Test keys (pk_test_, sk_test_) take no real money.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Search engines and analytics, compiled into the website (rebuild the frontend after a
# change). The verification code is the content="..." value of the meta tag that
# Google Search Console gives for the "HTML tag" method.
GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement ID (G-...). Empty: no analytics on the site.
GA_MEASUREMENT_ID=

# The "Leave a review" button in the thank-you email sent 3 hours after "Mark as returned":
# the Google Business Profile's "Ask for reviews" link (https://g.page/r/.../review).
# Empty: no review requests are sent.
GOOGLE_REVIEW_URL=

# The blog: the API asks the website to refresh its blog pages after a post is published,
# changed or deleted. Any long random string, the same for both (openssl rand -hex 32).
BLOG_REVALIDATE_SECRET=
